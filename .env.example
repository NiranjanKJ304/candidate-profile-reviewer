# Docker Compose configuration - OPTIONAL, NOT USED (Docker is not available).
# For local development use backend/.env.example and frontend/.env.example.
#
# Copy to .env in the project root and replace every change-me value:
#   Copy-Item .env.example .env
# Never commit .env. Use long random URL-safe values, e.g. generate with:
#   uv run --project backend python -c "import secrets; print(secrets.token_urlsafe(24))"
#
# For local (non-Docker) runs see backend/.env.example and frontend/.env.example.

# --- PostgreSQL (container) --------------------------------------------------
POSTGRES_USER=candidate_app
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=candidate_intel
# Host port; 5433 avoids clashing with a local PostgreSQL on 5432.
POSTGRES_HOST_PORT=5433

# --- Redis (container) -------------------------------------------------------
REDIS_PASSWORD=change-me-redis
REDIS_HOST_PORT=6379

# --- Backend (container) -----------------------------------------------------
BACKEND_HOST_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
ENABLED_PLATFORMS=

# --- Frontend (container) ----------------------------------------------------
FRONTEND_HOST_PORT=3000
# URL the *browser* uses to reach the backend (baked in at image build time).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
