# Backend configuration for local runs (no Docker).
# Never commit backend/.env.
#
# Easiest setup: run   powershell -ExecutionPolicy Bypass -File scripts\setup-local-db.ps1
# It copies this file to backend/.env, generates a random database password, and
# creates the candidate_app role and candidate_intel database in your local PostgreSQL.
#
# Local services:
#   PostgreSQL  - Windows service on 127.0.0.1:5432
#   Redis       - Memurai (Windows-native, Redis-compatible) on 127.0.0.1:6379
# Use 127.0.0.1, not "localhost": on Windows "localhost" tries IPv6 ::1 first and
# Memurai listens on IPv4 only, which adds ~2 s to every new Redis connection.
# Passwords inside URLs must be URL-safe (letters, digits, '-', '_', '.', '~') or
# percent-encoded.

# --- Application -------------------------------------------------------------
APP_NAME=Candidate Intelligence API
ENVIRONMENT=development          # development | test | staging | production
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=false                   # true = JSON lines (recommended outside local dev)

# --- HTTP / CORS (comma-separated; wildcard '*' is rejected in production) ----
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL (async driver required) --------------------------------------
DATABASE_URL=postgresql+asyncpg://candidate_app:change-me-postgres@127.0.0.1:5432/candidate_intel
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT_SECONDS=5
DB_ECHO=false                    # never true in production (logs SQL)

# --- Redis -------------------------------------------------------------------
# Memurai default install has no password and only listens on 127.0.0.1.
# If you enable requirepass, use: redis://:<password>@127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=5

# --- Health checks -----------------------------------------------------------
READINESS_TIMEOUT_SECONDS=2

# --- Platform integrations (collectors are implemented in later phases) -------
# Comma-separated subset of: github,leetcode,hackerrank,codeforces,codechef,kaggle
ENABLED_PLATFORMS=

# Credentials for later phases. Leave empty until the corresponding phase.
# GITHUB_TOKEN=
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# --- LLM for resume structuring (Phase 1A) ---------------------------------------
# Provider: groq | openrouter. Both use the OpenAI-compatible chat completions API.
LLM_PROVIDER=groq
# Paste your key after "=" (no quotes). Without it, resumes are extracted but end in
# parse_status=failed / parse_error_code=llm_not_configured; use "Retry parsing" later.
GROQ_API_KEY=
# OPENROUTER_API_KEY=
# Optional overrides (defaults: groq -> llama-3.3-70b-versatile). Set LLM_MODEL if the
# provider retires the default model.
# LLM_MODEL=
# LLM_BASE_URL=https://...        # must be https
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=2               # 1 call + 1 corrective retry for invalid JSON
LLM_MAX_INPUT_CHARS=60000

# --- Resume upload, storage and OCR (Phase 1A) -----------------------------------
# Original files are stored here (relative to backend/). Never serve this folder.
RESUME_STORAGE_DIR=storage/resumes
RESUME_MAX_BYTES=10485760        # 10 MB
RESUME_MAX_PAGES=30
OCR_ENABLED=true
# Folder containing eng.traineddata. Auto-detected for standard Tesseract installs
# (e.g. %LOCALAPPDATA%\Programs\Tesseract-OCR\tessdata); set only if detection fails.
# OCR_TESSDATA_DIR=
OCR_LANGUAGE=eng
OCR_DPI=300

# --- Job-description upload (Phase 1B; uses the LLM and OCR settings above) ------
JOB_DESCRIPTION_STORAGE_DIR=storage/job_descriptions
JOB_DESCRIPTION_MAX_BYTES=5242880    # 5 MB
JOB_DESCRIPTION_MAX_PAGES=20
