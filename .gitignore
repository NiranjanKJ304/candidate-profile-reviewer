# =============================================================================
# SECRETS & CREDENTIALS — never commit
# =============================================================================
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
kaggle.json
**/.kaggle/
credentials*.json
service-account*.json
secrets/
.secrets/
*.secret
.netrc
.pgpass

# =============================================================================
# CANDIDATE DATA / PII — never commit
# =============================================================================
uploads/
storage/
data/
candidate_data/
candidates/
resumes/
**/resumes/
reports/generated/
exports/
*.pdf
*.doc
*.docx
*.rtf
*.odt
# Synthetic, non-PII test fixtures only (added in later phases):
!backend/tests/fixtures/**/*.pdf
!backend/tests/fixtures/**/*.docx
# Next.js route folders share these names but contain source code, not candidate data.
!frontend/src/app/candidates/
!frontend/src/app/resumes/

# Database dumps / local DB files
*.sql.gz
*.dump
*.sqlite
*.sqlite3
*.db
dump.rdb

